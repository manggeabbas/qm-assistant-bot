# Application
AI_PROVIDER=deepseek

# AI API keys (leave empty; never commit real values)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# Telegram
TELEGRAM_BOT_TOKEN=

# Comma separated Telegram user ids allowed to use the bot.
# Leave empty for open access (development only).
ALLOWED_TELEGRAM_USER_IDS=
# Owner/admin ids (defaults to ALLOWED ids). Owners manage users at runtime:
#   /users, /allow <id> [admin|user], /deny <id>
BOT_OWNER_IDS=
# Owner Form Gulungan: bisa buka panel /admin + tombol Admin di menu,
# buat token undangan, dan kelola data karyawan. Isi ID Telegram numerik
# (boleh beberapa, pisahkan koma). WAJIB diisi agar /admin berfungsi.
OWNER_TELEGRAM_ID=
# Fail-closed: bot refuses to start if no user has access. Set to true ONLY for
# local development to run the bot open to everyone.
ALLOW_OPEN_ACCESS=false

# "Bot is processing" animated sticker (.tgs) indicator.
# By default the bot uses a native Telegram "typing" action (no files sent).
# To use the hourglass sticker, provide its Telegram file_id:
#   HOURGLASS_STICKER_FILE_ID=CAAC...
# Optional: upload the local .tgs (only if it is a VALID Telegram sticker;
# an invalid .tgs is delivered as a document/unrelated file).
HOURGLASS_STICKER_FILE_ID=
HOURGLASS_STICKER_PATH=assets/hourglass.tgs
HOURGLASS_STICKER_UPLOAD=false
PROCESSING_DELAY_SECONDS=0.5
# Keep the sticker visible at least this long (seconds)
PROCESSING_STICKER_MIN_SECONDS=0.7
